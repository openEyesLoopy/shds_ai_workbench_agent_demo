# 기본 분석 엔진 (claude / gemini / openai) — /settings 화면 또는 상단의 엔진 전환 버튼으로
# 언제든 즉시 바꿀 수 있으며, 이 값은 최초 기본값에만 영향을 줍니다.
DEFAULT_LLM_PROVIDER=claude

# Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-pro-preview

# ChatGPT (OpenAI)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# GitHub — 테스트반영(test 브랜치) 대상 데모 저장소. 아래 GITHUB_TOKEN이 이 저장소와
# PROD 저장소 모두에 대해 repo 쓰기 권한(Contents: Read and write)을 가지고 있어야 합니다.
GITHUB_TOKEN=
GITHUB_OWNER=openEyesLoopy
GITHUB_REPO=shds-demo-project-workbench

# 운영반영(main 브랜치) 대상 — test 저장소와는 별개의 운영 저장소입니다.
PROD_GITHUB_OWNER=openEyesLoopy
PROD_GITHUB_REPO=shds-demo-project-workbench_PROD

# "테스트 뷰어" 탭에 iframe으로 표시할 목업 Agent URL.
MOCKUP_URL=

# Vercel API — 테스트반영(test 브랜치 push) 후 해당 커밋의 Vercel 재배포가 READY 상태가
# 될 때까지 폴링하기 위한 자격 증명. vercel.com/account/tokens 에서 발급.
# 미설정 시 폴링 없이 곧바로 진행합니다 (기능은 선택적).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# 운영반영(main 브랜치) 대상 Vercel 프로젝트 — test 프로젝트와는 별개입니다.
VERCEL_PROD_PROJECT_ID=
